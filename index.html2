<!DOCTYPE html>
<html>
<head>
  <title>Devi Ali</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      text-align: center;
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
    }

    .container {
      margin-top: 100px;
    }

    img.profile {
      width: 120px;
      border-radius: 50%;
      margin-bottom: 20px;
      border: 3px solid white;
    }

    h1 {
      margin-bottom: 10px;
    }

    p {
      opacity: 0.8;
      margin-bottom: 30px;
    }

    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 260px;
      margin: 12px auto;
      padding: 14px;
      border-radius: 12px;
      text-decoration: none;
      color: white;
      font-weight: 600;
      transition: 0.3s;
    }

    .btn img {
      width: 22px;
      height: 22px;
    }

    .linkedin {
      background: #0077b5;
    }

    .instagram {
      background: #E1306C;
    }

    .btn:hover {
      transform: scale(1.05);
      opacity: 0.9;
    }
  </style>
</head>

<body>

  <div class="container">
    
    <img class="profile" src="https://i.pravatar.cc/150?img=32" alt="Profile">

    <h1>Devi Ali</h1>
    <p>Welcome to my personal links</p>

    <!-- LinkedIn -->
    <a class="btn linkedin" href="https://www.linkedin.com/in/deviali/" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/174/174857.png" alt="LinkedIn">
      LinkedIn
    </a>

    <!-- Instagram -->
    <a class="btn instagram" href="https://www.instagram.com/deviali21?igsh=MXR4dnI4eGQ0b2lldw==" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram">
      Instagram
    </a>

  </div>

</body>
</html>
